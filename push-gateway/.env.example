# Copy this file outside the repository or inject the values through your secret manager.
DB_URL=jdbc:mariadb://127.0.0.1:3306/business
DB_USERNAME=business
DB_PASSWORD=change-me

PUSH_SCHEDULER_ENABLED=true
PUSH_SCHEDULER_DELAY=30s
PUSH_BATCH_SIZE=100
PUSH_PROCESSING_TIMEOUT=5m
PUSH_MAX_ATTEMPTS=5

FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=your-firebase-project-id
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json

PUSH_QR_PRIVATE_KEY_PATH=/run/secrets/enrollment-key.pem
PUSH_QR_TTL=3m

PUSH_TEST_PAGE_ENABLED=false
PUSH_TEST_PAGE_USERNAME=push-admin
PUSH_TEST_PAGE_PASSWORD_HASH=$2y$12$replace-with-a-real-bcrypt-hash
PUSH_TEST_ENQUEUE_WHEN_FIREBASE_DISABLED=true
PUSH_TEST_REQUESTS_PER_MINUTE=10

SERVER_PORT=8080

# Relative to the process working directory; use an absolute path on servers.
PUSH_LOG_DIR=./logs
